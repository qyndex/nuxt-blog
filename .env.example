# Supabase connection (required when using @supabase/supabase-js in server routes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Optional — override the default public site metadata
NUXT_PUBLIC_SITE_NAME="The Dev Blog"
NUXT_PUBLIC_SITE_DESCRIPTION="Insights on web development, TypeScript, and architecture."
